# Generate your own administrator key.
CHATGPT2API_AUTH_KEY=
# CHATGPT2API_BASE_URL=https://portal.example.com
STORAGE_BACKEND=json
# DATABASE_URL=sqlite:////app/data/accounts.db
# DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE
# GIT_REPO_URL=https://github.com/OWNER/PRIVATE-DATA-REPOSITORY.git
# GIT_TOKEN=
# GIT_BRANCH=main
# GIT_FILE_PATH=accounts.json

# Nail Note standalone web app. Store the real values in an ignored .env file.
NAIL_PORT=19125
NAIL_DATA_DIR=/app/data
DATABASE_URL=file:/app/data/nail.db
ADMIN_USERNAME=owner-admin
# At least 12 characters. The first container start creates this admin; later starts do not reset its password.
ADMIN_PASSWORD=
IMAGE_API_BASE_URL=http://nail-gateway:3000/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2.5-sunburst
# Optional. Leave blank when the provider has no text model.
TEXT_MODEL=
COOKIE_SECURE=false
GATEWAY_SESSION_SECRET=
NAIL_VERSION=local
GATEWAY_VERSION=rc47-codexing
# Generate a long random value; required for the daily cleanup endpoint.
CRON_SECRET=
